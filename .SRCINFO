pkgbase = syn-remote
	pkgdesc = Remote desktop for SynapseOS — wayvnc, with the screen woken, the machine held awake while somebody is connected, and a magic packet to wake it when it is not
	pkgver = 0.1.0
	pkgrel = 8
	url = https://github.com/velle999/SYNAPSE
	arch = any
	license = GPL-2.0-or-later
	makedepends = pkgconf
	makedepends = gcc
	depends = bash
	depends = wayvnc
	depends = wlopm
	depends = openssl
	depends = systemd
	depends = gtk-vnc
	depends = gtk3
	depends = python
	optdepends = networkmanager: remember the wake setting across reboots
	optdepends = polkit: arm the card without being root
	optdepends = synui: hold the machine awake while somebody is connected
	optdepends = openssh: reach a loopback-bound server from another machine
	optdepends = quickshell: the Remote Desktop window — the CLI needs none of it
	optdepends = syntty: where `saved <name> set` asks for a password
	optdepends = libsecret: keep saved passwords in a keyring rather than a file
	source = syn-remote-0.1.0.tar.gz::https://github.com/velle999/syn-remote/releases/download/0.1.0-8/syn-remote-0.1.0.tar.gz
	sha256sums = SKIP

pkgname = syn-remote
